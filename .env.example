# Copy to .env and edit. Every value has a working default — this file is documentation.

# Where the UI is served and what the runner should call back on.
VIBEHUB_PORT=3010
VIBEHUB_PUBLIC_URL=http://vibehub:3010

# Where the runner container lives.
#   local = the Docker daemon this process can reach (socket mounted)
#   ssh   = a remote host; vibehub runs the same scripts over SSH
VIBEHUB_RUNNER_KIND=local
# VIBEHUB_RUNNER_SSH_HOST=10.0.0.5
# VIBEHUB_RUNNER_SSH_USER=root
# VIBEHUB_RUNNER_SSH_KEY=/data/keys/id_ed25519

# Runner container identity and persistent base directory (on the Docker host).
VIBEHUB_RUNNER_CONTAINER=vibehub-runner
VIBEHUB_RUNNER_IMAGE=node:24-bookworm
VIBEHUB_RUNNER_BASE_DIR=/opt/vibehub/runner
# Docker network the runner joins so it can reach vibehub by name. Under compose: "vibehub".
# Empty = default bridge; then VIBEHUB_PUBLIC_URL must be an address the runner can route to.
VIBEHUB_RUNNER_NETWORK=vibehub

# State: board.json, settings.json, users.json, secrets.enc, master.key.
VIBEHUB_DATA_DIR=/data

# Vault master key. Leave empty and vibehub generates one into VIBEHUB_DATA_DIR/master.key.
# Set it explicitly if you back up the data volume and the key separately.
VIBEHUB_SECRET_KEY=

# Session cookie signing secret. Empty = generated. Changing it logs everyone out.
VIBEHUB_SESSION_SECRET=

# Set to 1 when serving over plain http (LAN, VPN, localhost) so the session cookie is accepted.
VIBEHUB_INSECURE_COOKIES=0

VIBEHUB_LOG_LEVEL=info
